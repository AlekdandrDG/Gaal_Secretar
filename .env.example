# ── Обязательные ключи ────────────────────────────────────────────

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Deepgram API key for voice transcription
DEEPGRAM_API_KEY=

# Todoist API key for task management
TODOIST_API_KEY=

# JSON array of Telegram user IDs allowed to use the bot.
# ВАЖНО: это единственная защита бота. Пустой список = бот никого не пускает.
ALLOWED_USER_IDS=[123456789]

# Path to the thought-vault directory
VAULT_PATH=./vault

# ── Опционально: Google Calendar ──────────────────────────────────
# Без этих значений бот стартует нормально, просто не пишет в календарь.

# Path to Google service account credentials JSON
GOOGLE_CREDENTIALS_PATH=data/secrets/google-credentials.json

# Calendar to write events to (email of the calendar shared with the
# service account as editor). Default: primary
GOOGLE_CALENDAR_ID=

# ── Опционально ───────────────────────────────────────────────────

# Timezone for daily processing (e.g. Europe/Moscow). Default: UTC
TZ=

# Path to the claude CLI binary, if it is not on PATH
CLAUDE_BIN=
